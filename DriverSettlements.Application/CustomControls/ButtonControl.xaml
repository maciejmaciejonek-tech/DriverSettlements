<?xml version="1.0" encoding="utf-8" ?>
<Frame xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        BackgroundColor="{x:StaticResource Primary}"
        CornerRadius="8" Padding="8"
        x:Name="BtnControl"
        x:Class="DriverSettlements.App.CustomControls.ButtonControl" HorizontalOptions="Center">
    <Grid ColumnDefinitions="Auto,*">
        <ActivityIndicator x:Name="aiProgress"
            Grid.Column="1"
            HeightRequest="15" WidthRequest="15" 
            Color="White"
            IsRunning="True"            
            IsVisible="{Binding Source={x:Reference BtnControl}, Path=IsInProgress}"
            HorizontalOptions="Start"/>
        <Label x:Name="lblButtonText"             
            Grid.Column="2"
            Text="{Binding Source={x:Reference BtnControl}, Path=Text}" 
            TextColor="White"
            FontSize="14"
            VerticalTextAlignment="Center" 
            HorizontalTextAlignment="Center"
            VerticalOptions="Center"
            HorizontalOptions="Fill"/>
    </Grid>
    <Frame.Triggers>
        <DataTrigger TargetType="Frame" Binding="{Binding Source={x:Reference BtnControl}, Path=IsInProgress}" Value="True">
            <Setter Property="IsEnabled" Value="False"/>
        </DataTrigger>
        <DataTrigger TargetType="Frame" Binding="{Binding Source={x:Reference BtnControl}, Path=IsInProgress}" Value="False">
            <Setter Property="IsEnabled" Value="True"/>
        </DataTrigger>
    </Frame.Triggers>
    <Frame.GestureRecognizers>
        <TapGestureRecognizer 
            Command="{Binding Source={x:Reference BtnControl},Path=Command}"
            Tapped="TapGestureRecognizer_Tapped"/>
    </Frame.GestureRecognizers>
</Frame>
