<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:customControls="clr-namespace:DriverSettlements.App.CustomControls"
             xmlns:res="clr-namespace:DriverSettlements.App.Resources.Localization"
             xmlns:helpers="clr-namespace:DriverSettlements.App.Helpers"
             x:Class="DriverSettlements.App.ApplicationProfilesPage">
    <Grid
        Padding="5"
        RowDefinitions="*,50,5"
        ColumnDefinitions="*">
        <ListView Grid.Row="0" Grid.Column="0" HorizontalOptions="Center" SelectionMode="Single"
            x:Name="profilesView"
            BackgroundColor="Transparent"
            SeparatorColor="Silver"
            RowHeight="50"
            ItemSelected="profilesView_ItemSelected"
            ItemTapped="profilesView_ItemTapped" 
            Margin="5,5,5,5" IsPullToRefreshEnabled="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell    
                        Text="{Binding Name}">
                        <TextCell.Detail>
                            <Binding Path="Active">
                                <Binding.Converter>
                                    <helpers:BoolToObjectConverter x:TypeArguments="x:String"
                                                         TrueObject="{x:Static res:ApplicationStrings.ApplicationProfiles_Active}"
                                                         FalseObject="{x:Static res:ApplicationStrings.ApplicationProfiles_Available}"/>
                                </Binding.Converter>
                            </Binding>
                        </TextCell.Detail>
                        <TextCell.ContextActions>
                            <MenuItem Text="{x:Static res:ApplicationStrings.Actions_Edit}" 
                                    IsDestructive="True" Clicked="EditMenuItem_Clicked" CommandParameter="{Binding .}"/>
                            <MenuItem Text="{x:Static res:ApplicationStrings.Actions_Delete}" 
                                    IsDestructive="True" Clicked="DeleteMenuItem_Clicked" CommandParameter="{Binding .}"/>
                        </TextCell.ContextActions>
                    </TextCell>                        
                 </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <customControls:ButtonControl Grid.Row="1" Grid.Column="0"
                Text="{x:Static res:ApplicationStrings.ApplicationProfiles_AddProfile}"
                LoadingText="{x:Static res:ApplicationStrings.ApplicationProfiles_AddProfile}"
                Clicked="Button_Clicked"
                WidthRequest="180" HeightRequest="35"
                HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
