<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:customControls="clr-namespace:DriverSettlements.App.CustomControls"
             xmlns:res="clr-namespace:DriverSettlements.App.Resources.Localization"
             x:Class="DriverSettlements.App.TenantExternalServicesSettingsPage">
    <ScrollView>
        <VerticalStackLayout Spacing="10" Margin="5,5,5,5" HorizontalOptions="Fill">
            <Frame Padding="10,2,10,8">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="5" RowSpacing="2" ColumnDefinitions="*,Auto,Auto,*">
                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="Bolt" VerticalOptions="Center" HorizontalTextAlignment="Center" FontAttributes="Bold" FontSize="14"/>
                    <Label Grid.Row="1" Grid.Column="1" Text="ID" HorizontalOptions="End" VerticalOptions="Center"/>
                    <Entry Grid.Row="1" Grid.Column="2" x:Name="BoltCompanyId" Text="{Binding Tenant.BoltCompanyId}" MaxLength="5" Placeholder="XXXXX" HorizontalOptions="Start" VerticalOptions="Center" WidthRequest="250"/>
                    <Label Grid.Row="2" Grid.Column="1" Text="{x:Static res:ApplicationStrings.LegalEntity_EmailAddress}" HorizontalOptions="End" VerticalOptions="Center"/>
                    <Entry Grid.Row="2" Grid.Column="2" x:Name="BoltUserName" Text="{Binding Tenant.BoltUserName}" HorizontalOptions="Start" VerticalOptions="Center" WidthRequest="250"/>
                    <Label Grid.Row="3" Grid.Column="1" Text="{x:Static res:ApplicationStrings.Actions_Password}" HorizontalOptions="End" VerticalOptions="Center" />
                    <Entry Grid.Row="3" Grid.Column="2" x:Name="BoltPassword" Text="{Binding Tenant.BoltPassword}" IsPassword="true" HorizontalOptions="Start" VerticalOptions="Center" WidthRequest="250"/>
                    <customControls:ButtonControl Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" x:Name="ButtonBoltTest"                           
                            Text="{x:Static res:ApplicationStrings.Actions_MakeTest}"
                            LoadingText="{x:Static res:ApplicationStrings.Actions_MakeTest}"
                            IsEnabled="False"
                            Clicked="ButtonBoltTest_Clicked"
                            WidthRequest="150"/>
                </Grid>
            </Frame>
            <Frame Padding="10,2,10,8">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="5" RowSpacing="2" ColumnDefinitions="*,Auto,Auto,*">
                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="Uber" VerticalOptions="Center" HorizontalTextAlignment="Center" FontAttributes="Bold" FontSize="14"/>
                    <Label Grid.Row="1" Grid.Column="1" Text="ID" HorizontalOptions="End" VerticalOptions="Center"/>
                    <Entry Grid.Row="1" Grid.Column="2" x:Name="UberCompanyId" Text="{Binding Tenant.UberCompanyId}" MaxLength="36" Placeholder="XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX" HorizontalOptions="Start" VerticalOptions="Center" WidthRequest="250" FontSize="12"/>
                    <Label Grid.Row="2" Grid.Column="1" Text="{x:Static res:ApplicationStrings.LegalEntity_EmailAddress}" HorizontalOptions="End" VerticalOptions="Center"/>
                    <Entry Grid.Row="2" Grid.Column="2" x:Name="UberUserName" Text="{Binding Tenant.UberUserName}" HorizontalOptions="Start" VerticalOptions="Center" WidthRequest="250"/>
                    <Label Grid.Row="3" Grid.Column="1" Text="{x:Static res:ApplicationStrings.Actions_Password}" HorizontalOptions="End" VerticalOptions="Center" />
                    <Entry Grid.Row="3" Grid.Column="2" x:Name="UberPassword" Text="{Binding Tenant.UberPassword}" IsPassword="true" HorizontalOptions="Start" VerticalOptions="Center" WidthRequest="250"/>
                    <customControls:ButtonControl Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" x:Name="ButtonUberTest"
                            Text="{x:Static res:ApplicationStrings.Actions_MakeTest}"
                            LoadingText="{x:Static res:ApplicationStrings.Actions_MakeTest}"
                            IsEnabled="False"
                            Clicked="ButtonUberTest_Clicked"
                            WidthRequest="150"/>
                </Grid>
            </Frame>
            <Frame Padding="10,2,10,8">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="5" RowSpacing="2" ColumnDefinitions="*,Auto,Auto,*">
                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="Freenow" VerticalOptions="Center" HorizontalTextAlignment="Center" FontAttributes="Bold" FontSize="14"/>
                    <Label Grid.Row="1" Grid.Column="1" Text="{x:Static res:ApplicationStrings.LegalEntity_EmailAddress}" HorizontalOptions="End" VerticalOptions="Center"/>
                    <Entry Grid.Row="1" Grid.Column="2" x:Name="FreenowUserName" Text="{Binding Tenant.FreenowUserName}" HorizontalOptions="Start" VerticalOptions="Center" WidthRequest="250"/>
                    <Label Grid.Row="2" Grid.Column="1" Text="{x:Static res:ApplicationStrings.Actions_Password}" HorizontalOptions="End" VerticalOptions="Center" />
                    <Entry Grid.Row="2" Grid.Column="2" x:Name="FreenowPassword" Text="{Binding Tenant.FreenowPassword}" IsPassword="True" HorizontalOptions="Start" VerticalOptions="Center" WidthRequest="250"/>
                    <customControls:ButtonControl Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" x:Name="ButtonFreenowTest"
                            Text="{x:Static res:ApplicationStrings.Actions_MakeTest}"
                            LoadingText="{x:Static res:ApplicationStrings.Actions_MakeTest}"
                            IsEnabled="False"
                            Clicked="ButtonFreenowTest_Clicked"
                            WidthRequest="150"/>
                </Grid>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
