<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:customControls="clr-namespace:DriverSettlements.App.CustomControls"
             xmlns:res="clr-namespace:DriverSettlements.App.Resources.Localization"
             x:Class="DriverSettlements.App.TenantDetailsPage">
    <VerticalStackLayout Spacing="10" Margin="5,5,5,0" HorizontalOptions="Fill" >
        <Frame Padding="10,2,10,2">
            <HorizontalStackLayout>
                <Label Text="{x:Static res:ApplicationStrings.LegalEntity_FriendlyName}" VerticalOptions="Center" FontAttributes="Bold"/>
                <Label Text=":&#160;&#160;" VerticalOptions="Center" FontAttributes="Bold"/>
                <Entry x:Name="FriendlyName" VerticalOptions="Center" Text="{Binding Tenant.FriendlyName}"/>
            </HorizontalStackLayout>
        </Frame>
        <Frame Padding="10,2,10,2">
            <HorizontalStackLayout>
                <Label Text="{x:Static res:ApplicationStrings.LegalEntity_CompanyName}" VerticalOptions="Center" FontAttributes="Bold"/>
                <Label Text=":&#160;&#160;" VerticalOptions="Center" FontAttributes="Bold"/>
                <Entry x:Name="CompanyName" VerticalOptions="Center" Text="{Binding Tenant.CompanyName}"/>
            </HorizontalStackLayout>
        </Frame>
        <Frame Padding="10,2,10,2">
            <HorizontalStackLayout>
                <Label Text="{x:Static res:ApplicationStrings.LegalEntity_EmailAddress}" VerticalOptions="Center" FontAttributes="Bold"/>
                <Label Text=":&#160;&#160;" VerticalOptions="Center" FontAttributes="Bold"/>
                <Entry x:Name="EmailAddress" VerticalOptions="Center" Text="{Binding Tenant.EmailAddress}" />
            </HorizontalStackLayout>
        </Frame>
        <Frame Padding="10,2,10,2">
            <HorizontalStackLayout>
                <Label Text="{x:Static res:ApplicationStrings.LegalEntity_InvitationKey}" VerticalOptions="Center"/>
                <Label Text=":&#160;&#160;" VerticalOptions="Center"/>
                <Entry x:Name="InvitationKey" VerticalOptions="Center" Text="{Binding Tenant.InvitationKey}" IsReadOnly="True"/>
            </HorizontalStackLayout>
        </Frame>
        <Frame Padding="10,2,10,2">
            <HorizontalStackLayout>
                <Label Text="{x:Static res:ApplicationStrings.Actions_Blocked}" VerticalOptions="Center"/>
                <Label Text=":&#160;&#160;" VerticalOptions="Center"/>
                <Switch IsToggled="{Binding Tenant.Blocked}"/>
            </HorizontalStackLayout>
        </Frame>
        <Frame Padding="10,2,10,2">
            <HorizontalStackLayout>
                <Label Text="{x:Static res:ApplicationStrings.Actions_Deleted}" VerticalOptions="Center"/>
                <Label Text=":&#160;&#160;" VerticalOptions="Center"/>
                <Switch IsToggled="{Binding Tenant.Deleted}"/>
            </HorizontalStackLayout>
        </Frame>
        <Frame Padding="10,2,10,2">
            <HorizontalStackLayout>
                <Label Text="{x:Static res:ApplicationStrings.LegalEntity_ApplicationFeeBaseValue}" VerticalOptions="Center"/>
                <Label Text=":&#160;&#160;" VerticalOptions="Center"/>
                <Entry VerticalOptions="Center" Text="{Binding Tenant.ApplicationFeeBaseValue, StringFormat='{0:#0.00}'}" Keyboard="Numeric"/>
            </HorizontalStackLayout>
        </Frame>
        <Frame Padding="10,2,10,2">
            <HorizontalStackLayout>
                <Label Text="{x:Static res:ApplicationStrings.LegalEntity_ApplicationFeeChargeDriver}" VerticalOptions="Center"/>
                <Label Text=":&#160;&#160;" VerticalOptions="Center"/>
                <Switch IsToggled="{Binding Tenant.ApplicationFeeChargeDriver}"/>
            </HorizontalStackLayout>
        </Frame>
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
            <customControls:ButtonControl x:Name="SaveButton" 
                IsVisible="false"                                          
                Text="{x:Static res:ApplicationStrings.Actions_Save}"
                LoadingText="{x:Static res:ApplicationStrings.Actions_Save}"
                Clicked="SaveButton_Clicked"
                WidthRequest="150"/>
            <customControls:ButtonControl x:Name="CancelButton" 
                IsVisible="false"                                          
                Text="{x:Static res:ApplicationStrings.Actions_Cancel}"
                LoadingText="{x:Static res:ApplicationStrings.Actions_Cancel}"
                Clicked="CancelButton_Clicked"
                WidthRequest="150"/>
            <customControls:ButtonControl x:Name="SendInvitationKeyButton" 
                IsVisible="false"                                          
                Text="{x:Static res:ApplicationStrings.InvitationKey_SendInvitationKey}"
                LoadingText="{x:Static res:ApplicationStrings.InvitationKey_SendInvitationKey}"
                Clicked="SendInvitationKeyButton_Clicked"
                WidthRequest="250"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
    <!--TableView         
        Intent="Settings" HorizontalOptions="Center" Margin="5,5,5,5">
        <TableRoot>
            <TableSection>
                <EntryCell Label="Friendly name"
                       Placeholder="friendly name" 
                       Text="{Binding Tenant.FriendlyName}"/>
                <EntryCell Label="Company name"
                       Placeholder="company name" 
                       Text="{Binding Tenant.CompanyName}"/>
                <EntryCell Label="Email address"
                       Placeholder="email address" 
                       Text="{Binding Tenant.EmailAddress}"/>
                <TextCell Text="{Binding Tenant.InvitationKey}"/>
                <SwitchCell Text="Locked" On="{Binding Tenant.Locked}"/>
                <SwitchCell Text="Deleted" On="{Binding Tenant.Deleted}"/>
            </TableSection>
        </TableRoot>
    </TableView-->
</ContentPage>
