<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:customControls="clr-namespace:DriverSettlements.App.CustomControls"
             xmlns:res="clr-namespace:DriverSettlements.App.Resources.Localization"
             x:Class="DriverSettlements.App.MasterAdminSettingsPage">

    <ScrollView>
        <VerticalStackLayout
            VerticalOptions="Center" Spacing="5">
            <customControls:ButtonControl x:Name="AddDefaultReports" 
                Text="{x:Static res:ApplicationStrings.MasterAdminSettingsPage_AddDefaultReports}"
                LoadingText="{x:Static res:ApplicationStrings.MasterAdminSettingsPage_AddDefaultReports}"
                Clicked="AddDefaultReports_Clicked"
                WidthRequest="250"/>
            <customControls:ButtonControl x:Name="AddSettlementTypes" 
                Text="{x:Static res:ApplicationStrings.MasterAdminSettingsPage_AddSettlementTypes}"
                LoadingText="{x:Static res:ApplicationStrings.MasterAdminSettingsPage_AddSettlementTypes}"
                Clicked="AddSettlementTypes_Clicked"
                WidthRequest="250"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
