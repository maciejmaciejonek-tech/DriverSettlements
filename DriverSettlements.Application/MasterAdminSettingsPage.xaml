<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:customControls="clr-namespace:DriverSettlements.App.CustomControls"
             xmlns:res="clr-namespace:DriverSettlements.App.Resources.Localization"
             x:Class="DriverSettlements.App.MasterAdminSettingsPage">
    <Shell.TitleView>
        <Grid ColumnDefinitions="*,3">
            <Label x:Name="Title" Text="{x:Static res:ApplicationStrings.ShellContent_MasterAdminSettings}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Start" VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>
    <ScrollView>
        <VerticalStackLayout
            VerticalOptions="Center" Spacing="5">
            <Label Text="Button1:"/>
            <Label Text="{x:Static res:ApplicationStrings.MasterAdminSettingsPage_AddDefaultReports}"/>
            <Label Text="Button2:"/>
            <Label Text="{x:Static res:ApplicationStrings.MasterAdminSettingsPage_AddSettlementTypes}"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
