<?xml version="1.0" encoding="UTF-8" ?>
<customControls:ExtendedShell
    x:Class="DriverSettlements.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DriverSettlements.App"
    xmlns:customControls="clr-namespace:DriverSettlements.App.CustomControls"
    xmlns:res="clr-namespace:DriverSettlements.App.Resources.Localization"
    Shell.FlyoutBehavior="Flyout">
    <FlyoutItem x:Name="FlyoutItem" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent x:Name="MasterAdminTenantsShellContent"
            Route="MasterAdmin"
            Title="{x:Static res:ApplicationStrings.ShellContent_Tenants}"
            Icon ="contacts.png"
            ContentTemplate="{DataTemplate local:TenantsPage}"
            IsVisible="false"/>
        <ShellContent x:Name="MasterAdminSettingsShellContent"
            Title="{x:Static res:ApplicationStrings.ShellContent_MasterAdminSettings}"
            Icon ="settings.png"
            ContentTemplate="{DataTemplate local:MasterAdminSettingsPage}"
            IsVisible="false"/>
        <ShellContent x:Name="TenantWeeklySettlementsShellContent"
            Route="Tenant"
            Title="{x:Static res:ApplicationStrings.ShellContent_Weeks}"
            Icon ="calendar.png"
            ContentTemplate="{DataTemplate local:TenantWeekPage}"
            IsVisible="False"/>
        <ShellContent x:Name="TenantDriverListShellContent"
            Title="{x:Static res:ApplicationStrings.ShellContent_DriverList}"
            Icon ="contacts.png"
            ContentTemplate="{DataTemplate local:DriversPage}"
            IsVisible="False"/>
        <ShellContent x:Name="TenantCarsShellContent"
            Title="{x:Static res:ApplicationStrings.ShellContent_Cars}"
            Icon ="car.png"
            ContentTemplate="{DataTemplate local:TenantTariffPlansPage}"
            IsVisible="False"/>
        <ShellContent x:Name="TenantExternalServicesShellContent"
            Title="{x:Static res:ApplicationStrings.ShellContent_ExternalServices}"
            Icon ="services.png"
            ContentTemplate="{DataTemplate local:TenantExternalServicesSettingsPage}"
            IsVisible="false"/>
        <!--ShellContent x:Name="TenantExtrasAndDeductsShellContent"
            Title="{x:Static res:ApplicationStrings.ShellContent_ExtrasAndDeducts}"
            Icon ="plus_minus.png"
            ContentTemplate="{DataTemplate local:TenantExtrasAndDeductsPage}"
            IsVisible="False"/-->
        <!--ShellContent x:Name="TenantFuelBillsShellContent"
            Title="{x:Static res:ApplicationStrings.ShellContent_FuelBills}"
            Icon ="invoice.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            IsVisible="False"/-->
        <!--ShellContent x:Name="TenantInformationForDriversShellContent"
            Title="{x:Static res:ApplicationStrings.ShellContent_InformationForDrivers}"
            Icon ="info.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            IsVisible="False"/-->
        <ShellContent x:Name="DriverWeeklySetlementsShellContent"
            Route="Driver"
            Title="{x:Static res:ApplicationStrings.ShellContent_Weeks}"
            Icon ="calendar.png"
            ContentTemplate="{DataTemplate local:DriverWeekPage}"
            IsVisible="False"/>
        <ShellContent x:Name="DriverFuelBillsShellContent"
            Title="{x:Static res:ApplicationStrings.ShellContent_FuelBills}"
            Icon ="invoice.png"
            ContentTemplate="{DataTemplate local:DriverFuelBillsPage}"
            IsVisible="False"/>
        <ShellContent x:Name="DriverCarInspectionsShellContent"
            Title="{x:Static res:ApplicationStrings.ShellContent_CarInspections}"
            Icon ="car_repair.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            IsVisible="False"/>
        <ShellContent x:Name="DriverInfoShellContent"
            Title="{x:Static res:ApplicationStrings.ShellContent_Info}"
            Icon ="info.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            IsVisible="False"/>
        <ShellContent x:Name="InvitationShellContent"
            Route="Invitation"
            Title="{x:Static res:ApplicationStrings.ShellContent_Invitation}"
            Icon ="register.png"
            ContentTemplate="{DataTemplate local:InvitationPage}"
            IsVisible="False"/>
        <ShellContent x:Name="SettingsShellContent"
            Title="{x:Static res:ApplicationStrings.ShellContent_Settings}"
            Icon ="settings.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            IsVisible="False"/>
        <ShellContent x:Name="ProfilesShellContent"
            Title="{x:Static res:ApplicationStrings.ShellContent_Profiles}"
            Icon ="profiles.png"
            ContentTemplate="{DataTemplate local:ApplicationProfilesPage}"
            IsVisible="False"/>
        <ShellContent x:Name="ErrorShellContent"
            Title="{x:Static res:ApplicationStrings.ApplicationName}"
            ContentTemplate="{DataTemplate local:ErrorPage}"
            Route="ErrorPage"
            IsVisible="False"/>
        <ShellContent x:Name="WelcomeShellContent"
            Title="{x:Static res:ApplicationStrings.ApplicationName}"
            ContentTemplate="{DataTemplate local:WelcomePage}"
            IsVisible="True"/>
    </FlyoutItem>
</customControls:ExtendedShell>
