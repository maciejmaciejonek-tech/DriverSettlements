<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:customControls="clr-namespace:DriverSettlements.App.CustomControls"
             xmlns:res="clr-namespace:DriverSettlements.App.Resources.Localization"
             xmlns:helpers="clr-namespace:DriverSettlements.App.Helpers"
             x:Class="DriverSettlements.App.TenantFuelBillVerificationPage">
    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto">
            <Label x:Name="Title" Text="Weryfikacja rachunku" Grid.Column="0" FontSize="20" FontAttributes="Bold" HorizontalOptions="Start" VerticalOptions="Center" />
            <HorizontalStackLayout x:Name="Navigator" Spacing="5" Grid.Column="1" VerticalOptions="Center">
                <customControls:ButtonControl x:Name="PrevButton"
                        Text="&lt;" LoadingText="&lt;" BorderColor="LightSlateGray"
                        WidthRequest="40" FontSize="12" VerticalOptions="Center"
                        IsEnabled="True" Clicked="PrevButton_Clicked"/>
                <Label x:Name="NavigatorText" Text="1 z 5" FontSize="12" VerticalOptions="Center" TextColor="White" FontAttributes="Bold"/>
                <customControls:ButtonControl x:Name="NextButton" BorderColor="LightSlateGray"
                        Text=">" LoadingText=">" 
                        WidthRequest="40" FontSize="12" VerticalOptions="Center"
                        IsEnabled="True" Clicked="NextButton_Clicked"/>
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>
    <Grid ColumnDefinitions="*" RowDefinitions="Auto,*,Auto" Padding="5" RowSpacing="5">
        <Grid Grid.Row="0" ColumnDefinitions="*,auto,auto,10,auto,auto,*" RowDefinitions="Auto,Auto" HorizontalOptions="Center" ColumnSpacing="5">
            <Label Grid.Row="0" Grid.Column="1" Text="Wartość:" FontSize="12" HorizontalOptions="End" VerticalOptions="Center"/>
            <Label Grid.Row="0" Grid.Column="2" x:Name="Price" WidthRequest="65" FontSize="12" FontAttributes="Bold" HorizontalOptions="Start" VerticalOptions="Center"/>
            <Label Grid.Row="1" Grid.Column="1" Text="Data:" FontSize="12" HorizontalOptions="End" VerticalOptions="Center"/>
            <Label Grid.Row="1" Grid.Column="2" x:Name="Date" FontSize="12" FontAttributes="Bold" HorizontalOptions="Start" VerticalOptions="Center"/>
            <Label Grid.Row="0" Grid.Column="4" Text="Numer:" FontSize="12" HorizontalOptions="End" VerticalOptions="Center"/>
            <Label Grid.Row="0" Grid.Column="5" x:Name="ReferenceNumber" WidthRequest="150" FontSize="12" FontAttributes="Bold" HorizontalOptions="Start" VerticalOptions="Center" />
            <Label Grid.Row="1" Grid.Column="4" Text="Status:" FontSize="12" HorizontalOptions="End" VerticalOptions="Center"/>
            <Label Grid.Row="1" Grid.Column="5" x:Name="Status" WidthRequest="150" FontSize="12" FontAttributes="Bold" HorizontalOptions="Start" VerticalOptions="Center" />
        </Grid>
        <Border Grid.Row="1" Stroke="Black">
            <customControls:PinchToZoomAndPanContainer>
                <Image x:Name="SelectedImage"/>
            </customControls:PinchToZoomAndPanContainer>
        </Border>
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Grid.Row="2">
            <customControls:ButtonControl x:Name="CapturePhoto"
                        Text="Akceptuj" LoadingText="Akceptuj" 
                        WidthRequest="150" FontSize="12" VerticalOptions="Center"
                        IsEnabled="True" Clicked="AcceptFuelBill_Clicked"/>
            <customControls:ButtonControl
                        Text="Odrzuć" LoadingText="Odrzuć" 
                        WidthRequest="150" FontSize="12" VerticalOptions="Center"
                        IsEnabled="True" Clicked="RejectFuelBill_Clicked"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
