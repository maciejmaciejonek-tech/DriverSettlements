<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"    
             xmlns:zoft="http://zoft.MauiExtensions/Controls"
             xmlns:customControls="clr-namespace:DriverSettlements.App.CustomControls"
             xmlns:res="clr-namespace:DriverSettlements.App.Resources.Localization"
             xmlns:helpers="clr-namespace:DriverSettlements.App.Helpers"
             x:Class="DriverSettlements.App.TenantSettlementItemPage">
    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto">
            <Label x:Name="Title" Text="Rozliczenie" Grid.Column="0" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Start" VerticalOptions="Center" />
            <HorizontalStackLayout x:Name="Navigator" HorizontalOptions="End" Spacing="5" Padding="5" Grid.Column="1">
                <customControls:ButtonControl x:Name="SaveButton"
                        Text="Zapisz" LoadingText="Zapisz" BackgroundColor="OrangeRed" TextColor="Black" BorderColor="Black"
                        WidthRequest="60" FontSize="12" VerticalOptions="Center"
                        IsEnabled="True" Clicked="SaveButton_Clicked"/>
                <customControls:ButtonControl x:Name="CancelButton" BackgroundColor="OrangeRed" TextColor="Black" BorderColor="Black"
                        Text="Anuluj" LoadingText="Anuluj" 
                        WidthRequest="60" FontSize="12" VerticalOptions="Center"
                        IsEnabled="True" Clicked="CancelButton_Clicked"/>
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>
    <Grid RowDefinitions="10,*">
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="5" RowSpacing="3">
            <Label Grid.Row="0" Grid.Column="1" Text="Kierowca:" FontSize="14" HorizontalTextAlignment="End" VerticalOptions="Center"/>
            <zoft:AutoCompleteEntry Grid.Row="0" Grid.Column="2" x:Name="DriverName"
                Placeholder="Wyszukaj imię i nazwisko kierowcy" TextMemberPath="CompanyName" DisplayMemberPath="CompanyName"
                WidthRequest="250" MaximumWidthRequest="250" FontSize="14" ItemsSource="{Binding Drivers}"
                TextChanged="Drivers_TextChanged" SuggestionChosen="Drivers_SuggestionChosen" HorizontalOptions="Start"/>
            <Label Grid.Row="1" Grid.Column="1" Text="Rozliczenie:" FontSize="14" HorizontalTextAlignment="End" VerticalOptions="Center"/>
            <zoft:AutoCompleteEntry Grid.Row="1" Grid.Column="2" x:Name="SettlementTypeName"
                Placeholder="Wyszukaj nazwę rodzaju rozliczenia" TextMemberPath="TypeName" DisplayMemberPath="TypeName"
                WidthRequest="250" MaximumWidthRequest="250" FontSize="14" ItemsSource="{Binding SettlementTypes}"
                TextChanged="SettlementTypes_TextChanged" SuggestionChosen="SettlementTypes_SuggestionChosen" HorizontalOptions="Start"/>
            <customControls:ButtonControl Grid.Row="1" Grid.Column="3"
                    Text="..." HorizontalOptions="Start" WidthRequest="40"
                    Clicked="SettlementTypes_Clicked"
                    FontSize="12"/>
            <Label Grid.Row="2" Grid.Column="1" Text="Kwota:" FontSize="14" HorizontalOptions="End" VerticalOptions="Center"/>
            <Entry Grid.Row="2" Grid.Column="2" x:Name="WeeklyRate" 
                   Text="{Binding SettlementItem.Value, StringFormat='{0:#0.00}'}" FontSize="12" WidthRequest="150" Keyboard="Numeric"  HorizontalOptions="Start" Focused="WeeklyRate_Focused"/>
            <Label Grid.Row="3" Grid.Column="1" Grid.RowSpan="2" Text="Tryb:" FontSize="14" HorizontalOptions="End" VerticalOptions="Center"/>
            <Grid Grid.Row="3" RowSpacing="1" Grid.Column="2" ColumnDefinitions="*" RowDefinitions="38,38">
                <StackLayout Grid.Row="0" BackgroundColor="LightGray">
                    <RadioButton x:Name="PeriodicType0" Value="0" Content="Brak powielania" FontSize="14" GroupName="Periodic" />
                </StackLayout>
                <StackLayout Grid.Row="1" BackgroundColor="LightGreen">
                    <RadioButton x:Name="PeriodicType1" Value="1" Content="Powielanie" FontSize="14" GroupName="Periodic"/>
                </StackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
