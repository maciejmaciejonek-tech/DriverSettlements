<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:customControls="clr-namespace:DriverSettlements.App.CustomControls"
             xmlns:res="clr-namespace:DriverSettlements.App.Resources.Localization"
             x:Class="DriverSettlements.App.InvitationPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="25"
            Padding="30,0"
            VerticalOptions="Center">

            <Label
                Text="{x:Static res:ApplicationStrings.LegalEntity_InvitationKey}"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="24"
                HorizontalOptions="Center" />
            <Entry
                Placeholder = "{x:Static res:ApplicationStrings.LegalEntity_InvitationKey}"
                WidthRequest="300"
                x:Name="InvitationCode"
                IsPassword="True"
                MaxLength="8"/>

            <customControls:ButtonControl  
                Text="{x:Static res:ApplicationStrings.InvitationPage_RegisterApplication}"
                LoadingText="{x:Static res:ApplicationStrings.InvitationPage_RegisterApplication}"
                Clicked="OnClicked"
                WidthRequest="180"
                HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
