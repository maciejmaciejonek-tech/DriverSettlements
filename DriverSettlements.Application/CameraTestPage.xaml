<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:Camera.MAUI;assembly=Camera.MAUI"
             x:Class="DriverSettlements.App.CameraTestPage"
             Title="Inspekcje">
    <Grid RowDefinitions="*">
        <cv:CameraView x:Name="CameraView"
            Grid.Row="0"
            CamerasLoaded="CameraView_CamerasLoaded"/>
        <Image x:Name="MaskImage" Grid.Row="0" Opacity="0.4" Aspect="AspectFill"/>
        <Grid Grid.Row="0" RowDefinitions="*,auto" Margin="10,10,10,10">
            <Button Grid.Row="1" Text="Zrób zdjęcie" HorizontalOptions="Center" Clicked="Button_Clicked"/>
        </Grid>
    </Grid>    
</ContentPage>