<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:customControls="clr-namespace:DriverSettlements.App.CustomControls"
             xmlns:res="clr-namespace:DriverSettlements.App.Resources.Localization"
             x:Class="DriverSettlements.App.TenantsPage">
    <Grid
        Padding="5"
        RowDefinitions="50,*,50"
        ColumnDefinitions="*">
        <SearchBar Grid.Row="0" Grid.Column="0"
            x:Name="SearchBar"
            Placeholder="{x:Static res:ApplicationStrings.TenantsPage_SearchTenant}"
            TextChanged="SearchBar_TextChanged" SearchButtonPressed="SearchBar_SearchButtonPressed">
        </SearchBar>
        <ListView Grid.Row="1" Grid.Column="0" HorizontalOptions="Center"
            x:Name="tenantsView"
            BackgroundColor="Transparent"
            SeparatorColor="Silver"
            RowHeight="50"
            ItemSelected="tenantsView_ItemSelected"
            ItemTapped="tenantsView_ItemTapped" 
            Margin="5,5,5,5" IsPullToRefreshEnabled="True">
                <ListView.ItemTemplate>
                    <DataTemplate>
                    <TextCell 
                        Text="{Binding FriendlyName}"
                        Detail="{Binding CompanyName}">
                        <TextCell.ContextActions>
                            <MenuItem Text="{x:Static res:ApplicationStrings.Actions_Edit}" 
                                IsDestructive="True" Clicked="EditMenuItem_Clicked" CommandParameter="{Binding .}"/>
                            <MenuItem Text="{x:Static res:ApplicationStrings.Actions_Delete}" 
                                IsDestructive="True" Clicked="DeleteMenuItem_Clicked" CommandParameter="{Binding .}"/>
                        </TextCell.ContextActions>
                    </TextCell>
                </DataTemplate>
                </ListView.ItemTemplate>
        </ListView>
        <customControls:ButtonControl Grid.Row="2" Grid.Column="0"
                Text="{x:Static res:ApplicationStrings.TenantsPage_AddTenant}"
                LoadingText="{x:Static res:ApplicationStrings.TenantsPage_AddTenant}"
                Clicked="Button_Clicked"
                WidthRequest="180" HeightRequest="35"
                HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
